<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
        READ_SMS: lets the app list your existing text conversations.
        SEND_SMS: lets the app send the bulk reply (e.g. "STOP") and the
                  optional 7726 spam-forward on your behalf.
        These are ordinary runtime permissions - Android will show you a
        permission dialog the first time the app needs them. This app is
        NOT a default SMS handler, so it cannot delete messages from, or
        hide messages in, your regular Messages app - see the README for
        what that does and doesn't mean.
    -->
    <uses-permission android:name="android.permission.READ_SMS" />
    <uses-permission android:name="android.permission.SEND_SMS" />

    <application
        android:allowBackup="true"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.BulkTextReply"
        android:icon="@mipmap/ic_launcher">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.BulkTextReply">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            Round 5: lets CsvExporter.kt hand a CSV file to the share
            sheet (save/email/Drive) without this app needing broad
            storage permissions. Only exposes its own cache/exports/
            folder - see res/xml/file_paths.xml.
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
